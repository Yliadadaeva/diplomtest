<Window x:Class="NovosibirskForestRegistry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NovosibirskForestRegistry"
        Title="АИС «Лесной реестр» — г. Новосибирск" 
        Height="900" Width="1400" 
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- Кисти -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1B5E20"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#1565C0"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>

        <!-- Конвертер -->
        <local:StatusToBrushConverter x:Key="StatusToBrushConverter"/>

        <!-- Тень -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="Black"/>

        <!-- Стиль текстового поля -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль кнопки PrimaryButton -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопки SecondaryButton -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#EEEEEE"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Шаблон карточки участка -->
        <DataTemplate x:Key="ForestPlotCardTemplate">
            <Border Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="8" 
                    Margin="0,0,0,10" 
                    Padding="12" 
                    Effect="{StaticResource CardShadow}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{Binding Name}" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding CadastralNumber}" 
                               FontSize="11" 
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,0,0,8"/>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,5">
                        <TextBlock Text="Площадь: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Area, StringFormat={}{0:F1}}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                        <TextBlock Text=" га" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="3" Margin="0,0,0,5">
                        <TextBlock Text="Категория: " FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="4">
                        <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="10" Padding="6,2">
                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="🌲 Лесной реестр Новосибирска" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" | АИС учёта лесных участков" 
                               FontSize="14" 
                               Foreground="#E0E0E0" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="20" Padding="10,5" Margin="0,0,15,0">
                        <TextBlock x:Name="CurrentDateText" Foreground="White" FontSize="12"/>
                    </Border>
                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="20" Padding="10,5">
                        <TextBlock Text="👤 Администратор" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        
        
        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - фильтры и список -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="12" 
                    Margin="0,0,15,0" 
                    Padding="15"
                    Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="🔍 Фильтры поиска" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Название / Кадастровый номер" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="SearchBox" 
                                 Style="{StaticResource ModernTextBox}" 
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Категория защитности" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CategoryFilter" 
                                  Style="{StaticResource ModernComboBox}" 
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="Все категории" IsSelected="True"/>
                            <ComboBoxItem Content="Особо охраняемые природные территории"/>
                            <ComboBoxItem Content="Защитные леса"/>
                            <ComboBoxItem Content="Эксплуатационные леса"/>
                            <ComboBoxItem Content="Рекреационные зоны"/>
                        </ComboBox>

                        <TextBlock Text="Район города" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="DistrictFilter" 
                                  Style="{StaticResource ModernComboBox}" 
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="Все районы" IsSelected="True"/>
                            <ComboBoxItem Content="Заельцовский"/>
                            <ComboBoxItem Content="Центральный"/>
                            <ComboBoxItem Content="Дзержинский"/>
                            <ComboBoxItem Content="Октябрьский"/>
                            <ComboBoxItem Content="Калининский"/>
                        </ComboBox>

                        <TextBlock Text="Площадь (га)" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MinArea" Style="{StaticResource ModernTextBox}" Grid.Column="0"/>
                            <TextBlock Grid.Column="1" Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="MaxArea" Style="{StaticResource ModernTextBox}" Grid.Column="2"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button x:Name="ApplyFilterButton" 
                                    Content="Применить" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Width="100" 
                                    Margin="0,0,10,0"/>
                            <Button x:Name="ResetFilterButton" 
                                    Content="Сбросить" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Width="80"/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 Лесные участки" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="PlotsCountText" 
                                       Text="(0)" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox x:Name="PlotsListBox" 
                                 ItemsSource="{Binding FilteredPlots}" 
                                 ItemTemplate="{StaticResource ForestPlotCardTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectedItem="{Binding SelectedPlot, Mode=TwoWay}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Правая панель - карта и детали -->
            <Border Grid.Column="1" 
                    Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="12" 
                    Effect="{StaticResource CardShadow}"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🗺️ Карта лесных участков Новосибирска" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="#E8F5E9" CornerRadius="15" Padding="8,3" Margin="15,0,0,0">
                            <TextBlock Text="Интерактивный режим" FontSize="11" Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Карта (заглушка) -->
                    <Border Grid.Row="1" 
                            Background="#E8F5E9" 
                            CornerRadius="12" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🌳🌲🌿🍂" 
                                       FontSize="80" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Opacity="0.3"/>
                            <TextBlock Text="Интерактивная карта лесных участков" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="14"/>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                <Button Content="+" Width="35" Height="35" Margin="0,0,0,5" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="-" Width="35" Height="35" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Панель деталей выбранного участка -->
                    <Border Grid.Row="2" 
                            Background="#F9F9F9" 
                            CornerRadius="10" 
                            Padding="15" 
                            Margin="0,15,0,0" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                       Text="Информация о выбранном участке" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       Margin="0,0,0,10"/>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock x:Name="SelectedPlotName" 
                                           Text="Не выбран" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryBrush}" 
                                           Margin="0,0,0,8"/>

                                <WrapPanel Margin="0,0,0,5">
                                    <TextBlock Text="Кадастровый номер: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedPlotCadastral" Text="—" FontSize="12"/>
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,5">
                                    <TextBlock Text="Площадь: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedPlotArea" Text="—" FontSize="12"/>
                                    <TextBlock Text=" га" FontSize="12"/>
                                </WrapPanel>

                                <WrapPanel Margin="0,0,0,5">
                                    <TextBlock Text="Категория: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedPlotCategory" Text="—" FontSize="12"/>
                                </WrapPanel>

                                <WrapPanel>
                                    <TextBlock Text="Район: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedPlotDistrict" Text="—" FontSize="12"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="EditPlotButton" 
                                        Content="✏️ Редактировать" 
                                        Margin="0,0,10,0" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Width="110" 
                                        IsEnabled="False"/>
                                <Button x:Name="GenerateReportButton" 
                                        Content="📄 Отчёт" 
                                        Background="{StaticResource SecondaryBrush}" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Width="80" 
                                        IsEnabled="False"/>
                            </StackPanel>

                            <TextBlock x:Name="SelectedPlotStatus" 
                                       Grid.Row="2" 
                                       Grid.ColumnSpan="2" 
                                       Text="" 
                                       FontSize="11" 
                                       Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижняя панель статуса -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="LastUpdateText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" | Источник данных: Минприроды НСО" 
                               FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="15,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalPlotsText" 
                               Text="📊 Всего учтено: 0" 
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>